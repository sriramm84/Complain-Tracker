# Copy this file to .env and fill in the values

PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/complaint-tracker

# Long random string used to sign session cookies (required in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Gmail account used to send notifications and OTPs.
# MAIL_PASS must be a Gmail App Password, not your normal password.
# If these are left empty the app still works, but no emails are sent
# and complaint editing (which needs an emailed OTP) is unavailable.
MAIL_USER=
MAIL_PASS=

# First admin account, created by `npm run seed`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_PHONE=
